{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "payment_id": {
      "type": "string",
      "pattern": "^p_[0-9a-z]+$"
    },
    "wallet_id": {
      "type": "string",
      "pattern": "^w_[0-9a-z]+$"
    },
    "amount": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$"
    },
    "refunded": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$"
    },
    "balance_after": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 20
    }
  },
  "required": [
    "payment_id",
    "wallet_id",
    "amount",
    "refunded",
    "balance_after",
    "created_at"
  ],
  "additionalProperties": false
}
